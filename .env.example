NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/baidehi.sqlite3
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=admin
# Default password: Pokhara@123. Replace this hash before a public deployment.
ADMIN_PASSWORD_HASH=$2b$12$G/ngm8Y35YHQOYr4uTsGs./SOsaM5ixyUDybYPM.u7wxvUsODONde
UPLOAD_MAX_FILE_SIZE=5242880

# Contact-form email (SMTP). The form is still saved to the admin inbox when
# these are omitted, but no email notification is sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
CONTACT_EMAIL_FROM=website@example.com
CONTACT_EMAIL_TO=recipient@example.com
